{
    "name": "daily-pass/platform-mock",
    "description": "Local mock of the Carrier Platform",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "yiisoft/yii2": "~2.0.49"
    },
    "autoload": {
        "psr-4": {
            "Mock\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ]
}
